# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Use host.docker.internal (not localhost) when running in Docker on Windows/Mac -
# localhost inside a container refers to the container itself, not your host machine.
MONGODB_HOST=host.docker.internal
MONGODB_PORT=27017
MONGODB_DATABASE=support_desk_db
MONGODB_AUTHENTICATION_DATABASE=support_desk_db
MONGODB_USERNAME=your_mongo_user
MONGODB_PASSWORD=your_mongo_password

# Must be at least 32 characters. Never reuse the framework's built-in demo default.
JWT_SECRET=replace-with-a-real-random-secret-at-least-32-characters-long
