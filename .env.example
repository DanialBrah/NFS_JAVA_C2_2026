# Asset Tracker Application Configuration
# Copy this file to .env and fill in the values

# ===== REQUIRED =====
# JWT Secret for token signing (MUST be at least 32 characters, never use the demo key in production)
# Generate a secure key: $(openssl rand -base64 32)
APP_JWT_SECRET=your-secure-jwt-secret-minimum-32-characters-here-replace-me

# ===== OPTIONAL (defaults provided) =====
# JWT token expiration in minutes
APP_JWT_EXPIRATION_MINUTES=60

# MongoDB port on host machine (container always uses 27017 internally)
MONGO_HOST_PORT=27018

# Backend API port on host machine
BACKEND_PORT=8080

# Frontend UI port on host machine
FRONTEND_PORT=5173

# Alternative .env file
# ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Application ports
# ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8080
MONGO_PORT=27018

# ------------------------------------------------------------
# Spring Boot profile
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker

# ------------------------------------------------------------
# JWT configuration
# Use a long random value for real local work.
# Do not commit your real .env file.
# ------------------------------------------------------------
APP_JWT_SECRET=replace-with-a-long-random-local-dev-secret-at-least-32-characters

# ------------------------------------------------------------
# MongoDB configuration
# These are for the MongoDB container.
# ------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-with-local-root-password
MONGO_INITDB_DATABASE=asset_tracker_db

# ------------------------------------------------------------
# Application MongoDB user
# For a stronger setup, the app should not connect as root, so we create a dedicated database user for the app
# We may also create a script to createa this first user
# ------------------------------------------------------------
MONGO_APP_USERNAME=asset_app
MONGO_APP_PASSWORD=replace-with-local-app-password
MONGO_APP_DATABASE=asset_tracker_db
